# Regenerate the bot token in Discord Developer Portal before filling this file.
BOT_TOKEN=replace_with_new_token
CLIENT_ID=replace_with_application_id

# Optional: deploy commands instantly to one development server.
DEV_GUILD_ID=

# Runtime
DATA_DIR=./data
LOG_LEVEL=info
HEALTH_PORT=3000
SNAPSHOT_INTERVAL_MINUTES=15

# Application Emoji IDs (recommended). Leave blank to use text-only UI.
EMOJI_SHIELD_ID=
EMOJI_ALERT_ID=
EMOJI_LOCK_ID=
EMOJI_RESTORE_ID=
